# G1_sim — activate the IsaacSim 6.1 uv environment
#
# The Isaac Sim 6.1.0 installation lives in the uv-managed venv at
# /generalSSD/IsaacLab/isaac6/.venv (NOT a conda environment).
# Source the parent .envrc which sets up that venv + bundled ROS2 Jazzy.

# direnv-stdlib builtin; not available in plain bash, so guard it.
command -v source_up_if_exists >/dev/null && source_up_if_exists
source /generalSSD/IsaacLab/isaac6/.envrc

# G1_sim project root on PYTHONPATH so `import g1_sim` works from any subdir.
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"
